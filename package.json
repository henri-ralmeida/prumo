{
  "name": "@henri-ralmeida/prumo",
  "version": "2.5.1",
  "description": "Evidence-driven task orchestration with PO First for Claude Code, Kiro, Codex, DeepSeek Harness, Antigravity, OpenCode, Grok Build and GitHub Copilot",
  "type": "module",
  "bin": {
    "prumo": "bin/prumo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Henrique Almeida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henri-ralmeida/prumo.git"
  },
  "homepage": "https://github.com/henri-ralmeida/prumo#readme",
  "bugs": "https://github.com/henri-ralmeida/prumo/issues",
  "keywords": ["agent-skills", "claude-code", "kiro", "codex", "deepseek-harness", "dsh", "antigravity", "opencode", "grok-build", "github-copilot", "orchestration", "po-first"],
  "files": ["bin/", "lib/", "scripts/*.mjs", "!scripts/*.test.mjs", "!scripts/*-smoke.mjs", "scripts/messages.json", "scripts/release-notes.json", "scripts/dashboard.html", "references/", "SKILL.md", "README.md", "README.pt-BR.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test scripts/*.test.mjs test/*.test.mjs",
    "test:coverage": "node tools/run-coverage.mjs",
    "test:coverage:collect": "node tools/run-coverage.mjs --collect",
    "coverage:report": "c8 report",
    "coverage:merge": "node tools/coverage.mjs merge .test-output/coverage-artifacts",
    "check": "node scripts/check-package.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "istanbul-lib-coverage": "3.2.2"
  }
}
